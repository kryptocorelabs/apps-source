<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Chat-specific surfaces; all controls and palette come from the shared theme. -->
    <SolidColorBrush x:Key="BubbleIncoming" Color="#21323D"/>
    <SolidColorBrush x:Key="BubbleOutgoing" Color="#284B4D"/>
    <Style x:Key="MessengerCaption" TargetType="Button" BasedOn="{StaticResource AppCaption}"/>
    <Style x:Key="MessengerNavigation" TargetType="Button" BasedOn="{StaticResource AppNavigation}"/>
</ResourceDictionary>
